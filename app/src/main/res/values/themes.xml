<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.TriliumDroid" parent="Theme.AppCompat.DayNight">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_light</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorAccent">@color/primary</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/primary_dark</item>
        <!-- Customize your theme here. -->
        <item name="actionBarTheme">@style/Theme.TriliumDroid.AppBarOverlay</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/background</item>

        <item name="android:textColor">@color/foreground</item>
        <item name="android:textColorTertiary">@color/foreground</item>
        <item name="android:textAllCaps">false</item>
        <item name="alertDialogTheme">@style/Theme.TriliumDroid.Dialog</item>
        <item name="android:dialogCornerRadius" tools:targetApi="p">20dp</item>
    </style>

    <style name="Theme.TriliumDroid.Dialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:windowBackground">@drawable/bg_dialog_rounded</item>
        <item name="android:textColorPrimary">@color/foreground</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Theme.TriliumDroid.AppBarOverlay" parent="ThemeOverlay.AppCompat.ActionBar">
        <item name="colorControlNormal">@color/white</item>
    </style>

    <style name="Theme.TriliumDroid.AppWidgetContainerParent" parent="@android:style/Theme.DeviceDefault">
        <item name="appWidgetRadius">16dp</item>
        <item name="appWidgetInnerRadius">8dp</item>
    </style>

    <style name="Theme.TriliumDroid.AppWidgetContainer" parent="Theme.TriliumDroid.AppWidgetContainerParent">
        <item name="appWidgetPadding">16dp</item>
    </style>
</resources>
